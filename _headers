# Cloudflare Pages headers. Rules are additive: /* applies everywhere,
# per-app rules add the CSP for apps whose network surface is settled.
# Do NOT add a CSP under /* — two matching CSP headers are enforced as an
# intersection and would break the apps that still call third-party origins.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # payment=(self) so CardGuard can call PaymentRequest for Play Billing. Two
  # Permissions-Policy headers are intersected, so this cannot be re-granted in
  # a per-app block below — it has to be allowed here and used by nothing else.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(self), usb=()
  Cross-Origin-Opener-Policy: same-origin

# MeterSmart: fully self-contained. Only network call is ./fares.json on this origin.
/2_meter_smart/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'

# Live fare config must never be cached at the edge for long — rate changes
# have to reach clients on the next launch.
/2_meter_smart/fares.json
  Cache-Control: public, max-age=0, must-revalidate

# LingoLocal: static content, no network calls.
/5_lingo_local/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'

# CardGuard: network surface is settled — its reminders are computed on-device,
# so the only third parties are Google Fonts and, for the optional self-hosted
# Gmail import, Google Identity Services + the Gmail API. No Supabase/Workers
# origin is listed because nothing here talks to one.
/7_card_guard/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://gmail.googleapis.com https://accounts.google.com; frame-src https://accounts.google.com; form-action 'none'; frame-ancestors 'none'; base-uri 'none'

