  "narrative": {
    "northStar": "The Brass Thraasu on the Bill Pad",
    "overview": "Thraasu is an operate-mode counter tool: one shelf screen, a quantity bottom sheet, and a receipt slip. Its world is the Kerala shop counter: a warm bill-pad paper ground, a white receipt slip with a torn zigzag edge, banana-leaf green for the action that commits, the brass of the weighing balance for the brand and the scale, and chilli red for taking things off the bill. Products sit on round \"pans\" (scale pans) in produce-sack tints, one tint per category.\n\nDensity is phone-counter density: large tiles in the thumb zone, a pinned live total, every control at least 48 px. Type is a single family, Anek Malayalam, using its width axis to condense names on tiles and its weight range for money. All numbers are tabular. The system is light-only (a brand commitment in PRODUCT.md).\n\nIt rejects the POS-dashboard look: no sidebars, no KPI tiles, no on-screen data tables.",
    "keyCharacteristics": [
      "Warm paper ground, white slip surfaces, one green for commit and money.",
      "Brass is the instrument: scale drawing, brand mark, pan rims, focus ring.",
      "Eight produce-sack tint pairs keyed by category, with a brass fallback.",
      "One family (Anek Malayalam), condensed on tiles, heavy and tabular for totals.",
      "48 px touch floor; a single authored motion (the beam settling)."
    ],
    "rules": [
      {
        "name": "The Edge Is Not A Divider Rule",
        "body": "Controls a user types into or toggles (inputs, preset chips, the unit segmented toggle) take a 1.5 px field edge. The line colour is for dividers and for buttons whose label already identifies them; it never outlines an input.",
        "section": "colors"
      },
      {
        "name": "The Brass Carries No Text Rule",
        "body": "Brass (#B8862B) is for drawn metal. Any brass-coloured text, ring or outline uses brass-ink.",
        "section": "colors"
      },
      {
        "name": "The Chilli Removes Rule",
        "body": "Chilli appears only where something is taken off the bill or an entry is wrong. The spice category's red ink is a sack tint, not chilli.",
        "section": "colors"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "`font-variant-numeric: tabular-nums` is set on body; every price, quantity and total inherits it so columns of figures align.",
        "section": "typography"
      },
      {
        "name": "The Two Languages Rule",
        "body": "Malayalam leads; the English gloss sits underneath at label size in ink-2, marked `lang=\"en\"`.",
        "section": "typography"
      },
      {
        "name": "The Warm Shadow Rule",
        "body": "Shadows are tinted with the paper's brown (rgb 60,45,15) or the leaf, never neutral grey, except the toast, which floats over everything.",
        "section": "elevation"
      },
      {
        "name": "The One Settle Rule",
        "body": "The beam settle (760ms: dip to -7deg, swing past level to 3.2deg, rest) is the single authored motion moment, replayed each time the valid quantity changes. Everything else is functional feedback: press scale, bar bump, sheet rise (260ms), bill slide (280ms), toast. All share `--ease` and collapse under `prefers-reduced-motion`.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep every control at or above 48px; primary buttons are 52px and chips 54px.",
      "Do edge inputs, chips and toggles with field (#8F836B); keep line (#E1D9C8) for dividers.",
      "Do show money in leaf-deep, tabular, at display weight when it is the figure being read out.",
      "Do give every new category a tint / tint-ink pair; the brass fallback is a safety net, not a style.",
      "Do put product imagery inside a pan, over the emoji, never in place of it.",
      "Do keep the receipt print-only, black on white, within 72mm."
    ],
    "donts": [
      "Don't use brass (#B8862B) for text or rings; use brass-ink.",
      "Don't use chilli for anything but removal and invalid input.",
      "Don't add a second primary (leaf) button to a surface.",
      "Don't add a dark theme.",
      "Don't introduce dashboard furniture: sidebars, KPI tiles, on-screen data tables.",
      "Don't add a drag grip or a second decorative animation to the sheet; the beam settle is the one."
    ]
  }
}
