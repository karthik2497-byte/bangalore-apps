      "css": ".ds-bar{display:flex;align-items:center;gap:12px;width:360px;min-height:64px;padding:8px 8px 8px 18px;border:0;border-radius:18px;background:#1E6B3A;color:#fff;text-align:left;font-family:'Anek Malayalam',system-ui,sans-serif;font-variant-numeric:tabular-nums;box-shadow:0 6px 20px rgba(21,79,42,.3);cursor:pointer} .ds-bar:focus-visible{outline:3px solid #7A5610;outline-offset:2px} .ds-sum{display:flex;flex-direction:column;line-height:1.2} .ds-sum span{font-size:14px;font-weight:500} .ds-sum b{font-size:23px;font-weight:750} .ds-go{margin-left:auto;padding:11px 10px 11px 16px;border-radius:12px;background:rgba(255,255,255,.16);font-weight:650}"
