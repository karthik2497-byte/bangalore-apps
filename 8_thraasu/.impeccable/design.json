      "css": ".ds-cat{display:flex;flex-direction:column;align-items:flex-start;gap:1px;width:170px;min-height:116px;padding:14px 14px 12px;border:0;border-radius:14px;background:#E2EED9;color:#2E5E22;text-align:left;font-family:'Anek Malayalam',system-ui,sans-serif;cursor:pointer;transition:transform 160ms cubic-bezier(.2,.8,.2,1)} .ds-cat:active{transform:scale(.97)} .ds-cat:focus-visible{outline:3px solid #7A5610;outline-offset:2px} .ds-emo{font-family:'Noto Color Emoji','Apple Color Emoji',sans-serif;font-size:34px;line-height:1;margin-bottom:auto;padding-bottom:10px} .ds-cat b{font-size:19px;font-weight:680;line-height:1.25;font-stretch:92%} .ds-cat small{font-size:13.5px;font-weight:500}"
