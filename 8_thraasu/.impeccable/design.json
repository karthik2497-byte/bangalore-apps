      "css": ".ds-search{position:relative;display:block;max-width:360px} .ds-search svg{position:absolute;left:15px;top:50%;width:20px;height:20px;transform:translateY(-50%);stroke:#4B584F;fill:none;stroke-width:2;pointer-events:none} .ds-search input{width:100%;box-sizing:border-box;height:54px;padding:0 16px 0 46px;border:1.5px solid #8F836B;border-radius:14px;background:#fff;color:#1C2620;font:400 17px 'Anek Malayalam',system-ui,sans-serif} .ds-search input::placeholder{color:#6A746C} .ds-search input:focus{outline:none;border-color:#1E6B3A;box-shadow:0 0 0 3px #E2EEE0}"
